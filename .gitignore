# =============================================================
# CyberPhysicalBanking v2 — .gitignore
# =============================================================

# ── Environment & Secrets ────────────────────────────────────
.env
.env.local
# NEVER commit real credentials
credentials.txt

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Django ────────────────────────────────────────────────────
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
*.sqlite3
staticfiles/
static/

# ── Media / Uploads ───────────────────────────────────────────
media/

# ── IDE & OS ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Testing & Coverage ────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Docker ───────────────────────────────────────────────────
docker-compose.override.yml

# ── ChromaDB local persistence (generated at runtime) ────────
chroma_db/
chromadb/

# ── Frontend & Node ──────────────────────────────────────────
.next/
frontend/.next/
node_modules/
frontend/node_modules/
playwright-report/
frontend/playwright-report/
test-results/
frontend/test-results/
