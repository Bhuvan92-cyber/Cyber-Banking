# =============================================================
# CyberPhysicalBanking v2 — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.
# =============================================================

# ── Django Core ──────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-here-change-this-min-50-chars
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Database (PostgreSQL) ─────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://cyber_user:your_strong_password@localhost:5432/cyber_banking

# ── Security Headers (set True in production) ─────────────────
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ── LLM / RAG Pipeline (Phase 4 & 5) ─────────────────────────
# URL of your local Ollama server (default port 11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Generation model in Ollama: e.g. llama3
OLLAMA_LLM_MODEL=llama3
OLLAMA_MODEL=llama3
# Embedding model in Ollama: e.g. nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# ChromaDB configuration (Leave CHROMA_HOST empty for local embedded/persistent mode)
CHROMA_PERSIST_DIRECTORY=chroma_db
CHROMA_HOST=
CHROMA_PORT=8000

# ── Media & Storage ───────────────────────────────────────────
MEDIA_ROOT=/app/media
